rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 0: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // The "Master Gate" (Relational Sync)
    function isCoachEmail() {
      return request.auth.token.email != null && (
        request.auth.token.email == 'brentnevills@gmail.com' ||
        request.auth.token.email == 'brent.nevills@sccdsb.net' ||
        request.auth.token.email.matches('.*coach.*') ||
        request.auth.token.email.matches('.*nevills.*')
      );
    }

    function isTeamMember(teamId) {
      let isCoach = isCoachEmail();
      let isDefaultTeam = teamId == 'ucc_main';
      let hasTeamDoc = exists(/databases/$(database)/documents/teams/$(teamId));
      let isCreator = hasTeamDoc && get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
      let hasMemberDoc = exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        || existsAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));

      // If team document doesn't exist yet in Firestore, allow signed-in user to initialize it
      return !hasTeamDoc || isCoach || isDefaultTeam || hasMemberDoc || isCreator;
    }

    function isCoach(teamId) {
      let isCoachUser = isCoachEmail();
      let isDefaultTeam = teamId == 'ucc_main';
      let hasTeamDoc = exists(/databases/$(database)/documents/teams/$(teamId));
      let isCreator = hasTeamDoc && get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
      let hasMemberDoc = exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      let isCoachRole = hasMemberDoc && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach';
      
      // If team document doesn't exist yet in Firestore, allow signed-in user to create/manage it
      return !hasTeamDoc || isCoachUser || isDefaultTeam || isCreator || isCoachRole;
    }

    function isValidTeamMember(data, userId) {
      return data.keys().hasAll(['uid', 'role']) 
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.uid == userId
        && data.role in ['coach', 'player'];
    }

    function isValidPlayerAccessLog(data, userId) {
      return data.keys().hasAll(['id', 'uid'])
        && data.id is string && data.id.size() <= 128
        && data.uid is string && data.uid == userId;
    }

    function isValidSetting(data) {
      return data.keys().hasAny(['roster', 'savedRosters', 'savedLineups', 'teamName', 'coachCode', 'playerCode', 'playerAccessEnabled'])
        && (!('roster' in data) || data.roster is list && data.roster.size() <= 100)
        && (!('savedRosters' in data) || data.savedRosters is map)
        && (!('savedLineups' in data) || data.savedLineups is map)
        && (!('teamName' in data) || data.teamName is string && data.teamName.size() <= 100)
        && (!('coachCode' in data) || data.coachCode is string && data.coachCode.size() <= 20)
        && (!('playerCode' in data) || data.playerCode is string && data.playerCode.size() <= 20)
        && (!('playerAccessEnabled' in data) || data.playerAccessEnabled is bool);
    }

    function isValidMatch(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('opponent' in data) || (data.opponent is string && data.opponent.size() <= 128));
    }

    function isValidSet(data) {
      return (!('id' in data) || data.id is string)
        && (!('matchId' in data) || data.matchId is string);
    }

    function isValidStat(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('matchId' in data) || (data.matchId is string && data.matchId.size() <= 128))
        && (!('setId' in data) || (data.setId is string && data.setId.size() <= 128));
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }

    match /share_codes/{codeId} {
      allow read, write: if isSignedIn() && isValidId(codeId);
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /teams/{teamId} {
      allow create: if isSignedIn() && isValidId(teamId);
      allow get, list: if isSignedIn() && isValidId(teamId);
      allow update: if isSignedIn() && (isCoach(teamId) || isTeamMember(teamId));
      allow delete: if isSignedIn() && isCoach(teamId);

      match /members/{userId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
        allow delete: if isSignedIn() && (request.auth.uid == userId || isCoach(teamId));
      }

      match /player_access_logs/{logId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create: if isSignedIn() && isTeamMember(teamId) && isValidId(logId);
      }

      match /settings/{settingId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow write: if isSignedIn() && (isCoach(teamId) || isTeamMember(teamId));
      }

      match /opponents/{opponentId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow write: if isSignedIn() && (isCoach(teamId) || isTeamMember(teamId));
      }

      match /opponent_notes/{oppName} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow write: if isSignedIn() && (isCoach(teamId) || isTeamMember(teamId));
      }

      match /matches/{matchId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create, update: if isSignedIn() && (isCoach(teamId) || isTeamMember(teamId))
          && isValidMatch(incoming());
        allow delete: if isSignedIn() && isCoach(teamId);
      }

      match /sets/{setId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create, update: if isSignedIn() && (isCoach(teamId) || isTeamMember(teamId))
          && isValidSet(incoming());
        allow delete: if isSignedIn() && isCoach(teamId);
      }

      match /stats/{statId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create, update: if isSignedIn() && (isCoach(teamId) || isTeamMember(teamId))
          && isValidStat(incoming());
        allow delete: if isSignedIn() && isCoach(teamId);
      }
    }
  }
}
